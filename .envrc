# Loaded by direnv on entering this directory, unloaded on leaving.
#
# Setup:
#   brew install direnv # or whatever package manager you use
#   echo 'eval "$(direnv hook bash)"' >> ~/.bashrc && exec bash
#   direnv allow          # required once here, and again after ANY edit to this file
#
# Pairs with .tool-versions, which pins the kubectl VERSION for this directory.
#
# expand_path resolves relative to THIS file, so subdirectories work too.

export KUBECONFIG="$(expand_path ./k8s/access/oidc-kubeconfig)"
